OIDC_DISCOVERY_URL=https://intraauth.femh.org.tw/INTRAAUTHSERVER/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Set the hospital-confirmed audience to enable RS256 JWT Access Token verification; blank uses UserInfo.
OIDC_AUDIENCE=
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
SESSION_SECRET=
APP_BASE_URL=http://localhost:8000
APP_ENV=development
OIDC_DEBUG_CLAIMS=false

# Hospital identity claim confirmed as sub. Set real subject IDs only on the server.
# Exact case-sensitive match; real IDs belong only in server environment.
ADMIN_IDENTITY_CLAIM=sub
SYSTEM_ADMIN_IDS=
DATA_DIRECTORY=var
