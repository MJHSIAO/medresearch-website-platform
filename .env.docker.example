# 示範設定；請複製為 .env.docker，只在 server 填入院方核發的資料。
OIDC_DISCOVERY_URL=https://intraauth.femh.org.tw/INTRAAUTHSERVER/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 填院方確認的 JWT Access Token audience 即啟用 RS256 JWT 驗證；留空使用 UserInfo。
OIDC_AUDIENCE=
OIDC_REDIRECT_URI=https://aics.femh.org.tw/medresearch/auth/callback
SESSION_SECRET=
APP_BASE_URL=https://aics.femh.org.tw/medresearch
APP_ENV=production
OIDC_DEBUG_CLAIMS=false

# Confirm the verified identity field in /internal after signing in.
# Exact case-sensitive match; real IDs belong only in server environment.
ADMIN_IDENTITY_CLAIM=
SYSTEM_ADMIN_IDS=
