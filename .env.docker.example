# 示範設定；請複製為 .env.docker，只在 server 填入院方核發的資料。
OIDC_DISCOVERY_URL=https://intraauth.femh.org.tw/INTRAAUTHSERVER/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 院方確認的 JWT Access Token audience；可留空，目前僅預留設定，尚未啟用 JWT 驗證。
OIDC_AUDIENCE=
OIDC_REDIRECT_URI=https://aics.femh.org.tw/medresearch/auth/callback
SESSION_SECRET=
APP_BASE_URL=https://aics.femh.org.tw/medresearch
APP_ENV=production
OIDC_DEBUG_CLAIMS=false
